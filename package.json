{
  "name": "resume-portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "npm run cf:typegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:ci": "npm run cf:clean && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cf:clean": "node scripts/clean-cloudflare-output.mjs",
    "cf:typegen": "npm run cf:clean && wrangler types",
    "deploy:dry": "npm run check && npm run build && wrangler deploy --dry-run",
    "predeploy": "npm run check && npm run build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@fontsource/fira-mono": "^5.2.7",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.8.0",
    "@neoconfetti/svelte": "^2.2.2",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/gsap": "^3.0.0",
    "@types/node": "^25.6.0",
    "@types/three": "^0.184.0",
    "bits-ui": "^2.18.0",
    "clsx": "^2.1.1",
    "svelte": "^5.51.0",
    "svelte-check": "^4.3.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "gsap": "^3.15.0",
    "ogl": "^1.0.11",
    "tailwindcss": "^4.2.1",
    "three": "^0.184.0"
  }
}
